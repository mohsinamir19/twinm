# LLM (Groq, OpenAI-compatible)
GROQ_API_KEY=
# MODEL_ID=openai/gpt-oss-120b      # or openai/gpt-oss-20b (faster)

# Pushover notifications (optional)
PUSHOVER_TOKEN=
PUSHOVER_USER=
# NOTIFY_ON_ACTIONS=true            # auto-push after booking/adding/etc.

# REQUIRED for the private Chief of Staff (/owner/chat, /workspace, /conversation).
# Pick a long passphrase; you type it in the UI when you switch to Chief of Staff.
# Without it the owner endpoints are closed (set ALLOW_OPEN_OWNER=true only for local dev).
OWNER_TOKEN=
# ALLOW_OPEN_OWNER=false

# ---- Public AI Twin (website visitors) ----
# OWNER_NAME=Mohsin                 # used in the confirmation email
# PUBLIC_CONTACT_EMAIL=             # shown when a chat hits the turn limit
# PUBLIC_WORK_START=10              # bookable hours, in TWIN_TZ
# PUBLIC_WORK_END=18
# PUBLIC_WORK_DAYS=0,1,2,3,4        # Mon=0 ... Sun=6
# PUBLIC_MIN_NOTICE_HOURS=4
# PUBLIC_CHAT_PER_MIN=15            # per IP
# PUBLIC_MAX_TURNS=20               # visitor messages per chat
# PUBLIC_DAILY_CHAT_CAP=500         # all visitors, per day
# PUBLIC_MAX_EMAILS_PER_DAY=30      # confirmation emails
# TRUST_PROXY=false                 # true only behind your own proxy (uses X-Forwarded-For)
# Separate Notion database for leads (needs a title column; optional: Email, Status, Budget,
# Interest, Meeting, Session). Never reuse the private notes database.
# NOTION_LEADS_DB_ID=

# Timezone used for dates and bookings
# TWIN_TZ=Asia/Karachi

# Google Calendar + Meet + Tasks (run google_auth.py once to log in)
GOOGLE_CALENDAR_ID=primary

# Notion notes (share the page/database with your integration first)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---- Voice (Deepgram STT + TTS over plain HTTPS, no extra server). See ../docs/voice-setup.md ----
DEEPGRAM_API_KEY=
# Optional: Gemini TTS instead of Deepgram Aura-2 (GOOGLE_API_KEY also works)
# GEMINI_API_KEY=
# VOICE_TTS=deepgram                # deepgram (default) | gemini
# VOICE_TTS_MODEL=aura-2-thalia-en  # any Deepgram Aura-2 voice
# VOICE_GEMINI_VOICE=Kore           # only when VOICE_TTS=gemini
